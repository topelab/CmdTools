  <Commands package="ProjectRelations">
    <Groups>
      <Group guid="ProjectRelations" id="MyMenuGroup" priority="0x0600">
        <Parent guid="VSMainMenu" id="ProjectNode"/>
      </Group>
    </Groups>

    <!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
    <Buttons>
      <Button guid="ProjectRelations" id="OpenUsedByProjectCommand" priority="0x0100" type="Button">
        <Parent guid="ProjectRelations" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Relationship" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Show projects used by this project</ButtonText>
          <LocCanonicalName>.ProjectRelations.OpenUsedByProjectCommand</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="ProjectRelations" id="OpenUsingProjectCommand" priority="0x0101" type="Button">
        <Parent guid="ProjectRelations" id="MyMenuGroup" />
        <Icon guid="ImageCatalogGuid" id="Relationship" />
        <CommandFlag>IconIsMoniker</CommandFlag>
        <Strings>
          <ButtonText>Show projects using this project</ButtonText>
          <LocCanonicalName>.ProjectRelations.OpenUsingProjectCommand</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <Symbols>
    <GuidSymbol name="ProjectRelations" value="{8ad26e4f-d35f-4e9a-9a14-58428a97ab50}">
      <IDSymbol name="MyMenuGroup" value="0x0001" />
      <IDSymbol name="OpenUsedByProjectCommand" value="0x0100" />
      <IDSymbol name="OpenUsingProjectCommand" value="0x0101" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
