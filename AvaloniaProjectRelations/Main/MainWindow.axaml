<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaProjectRelations.Main"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
		Height="1200"
		Width="1600"
        x:Class="AvaloniaProjectRelations.Main.MainWindow"
        x:DataType="vm:MainWindowVM"
        Icon="/Assets/avalonia-logo.ico"
		xmlns:res="using:AvaloniaProjectRelations.Resources"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        Title="{Binding Title}">
		<Grid RowDefinitions="Auto, *">
			<Menu Grid.Row="0"
				Height="60"
				Padding="10">
				<MenuItem>
					<MenuItem.Header>
						<TextBlock ToolTip.Tip="{x:Static res:Strings.Menu}">
							<materialIcons:MaterialIcon Kind="Menu" Foreground="{DynamicResource SystemAccentColor}" />
						</TextBlock>
					</MenuItem.Header>
				</MenuItem>
			</Menu>
			<ContentControl Grid.Row="1" Content="{Binding ContentViewModel}" />
		</Grid>
</Window>
