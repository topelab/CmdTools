<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:filterNumeric="using:Topelab.Core.Avalonia.Filter.NumericRange"
		xmlns:filterDate="using:Topelab.Core.Avalonia.Filter.DateRange"
		xmlns:filterCombo="using:Topelab.Core.Avalonia.Filter.Combo"
		xmlns:filterTime="using:Topelab.Core.Avalonia.Filter.TimeRange"
		xmlns:filterText="using:Topelab.Core.Avalonia.Filter.Text"
	    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
	<Design.PreviewWith>
		<StackPanel Width="800" Height="400" Spacing="20">
			<Button Classes="Mine" Margin="5">
				<materialIcons:MaterialIcon Kind="CalendarAdd" />
			</Button>
			<Button Classes="Big" Margin="5">
				<materialIcons:MaterialIcon Kind="CalendarAdd" />
			</Button>
			<Button Classes="Flat" Margin="5" Content="HELLO" />
			<Grid Classes="Form" RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="60, 10, 600">
				<TextBlock Grid.Row="0" Grid.Column="0" Text="Hello my friend" />
				<TextBox Grid.Row="0" Grid.Column="2" Text="Write here" />
				<TextBlock Grid.Row="1" Grid.Column="0" Text="Hello" />
				<ComboBox Grid.Row="1" Grid.Column="2" SelectedIndex="0">
					<ComboBoxItem Content="Item 1" />
					<ComboBoxItem Content="Item 2" />
					<ComboBoxItem Content="Item 3" />

				</ComboBox>
			</Grid>
			<TimePicker SelectedTime="8:00"
						ClockIdentifier="24HourClock"
						MinuteIncrement="5"
						Margin="10,5" />

		</StackPanel>
	</Design.PreviewWith>

	<Style Selector="Button.Mine">
		<Setter Property="Padding" Value="2" />
		<Setter Property="Margin" Value="2" />
	</Style>
	<Style Selector="Button.Flat">
		<Setter Property="Padding" Value="10" />
		<Setter Property="Margin" Value="2" />
	</Style>
	<Style Selector="materialIcons|MaterialIcon">
		<Setter Property="Height" Value="24" />
		<Setter Property="Width" Value="24" />
	</Style>
	<Style Selector="Button.Big materialIcons|MaterialIcon">
		<Setter Property="Height" Value="48" />
		<Setter Property="Width" Value="48" />
	</Style>
	<Style Selector="Grid.Form">
		<Setter Property="Margin" Value="10" />
	</Style>
	<Style Selector="Grid.Form > TextBlock">
		<Setter Property="HorizontalAlignment"  Value="Right" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="Margin" Value="0,0,10,0" />
	</Style>
	<Style Selector="Grid.Form > TextBlock.Title">
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="FontSize" Value="20" />
		<Setter Property="FontWeight" Value="Bold" />
		<Setter Property="Margin" Value="20" />
	</Style>
	<Style Selector="Grid.Form > TextBlock.Left">
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="Margin" Value="10,0,0,0" />
	</Style>
	<Style Selector="Grid.Form > TextBox, Grid.Form > StackPanel, Grid.Form > NumericUpDown, Grid.Form > CalendarDatePicker">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="Margin" Value="5" />
	</Style>
	<Style Selector="Grid.Form > NumericUpDown.Integer">
		<Setter Property="Width" Value="150" />
		<Setter Property="Increment" Value="1" />
	</Style>

	<Style Selector="Grid.Form > NumericUpDown.Integer TextBox">
		<Setter Property="IsReadOnly" Value="True" />
	</Style>

	<Style Selector="Grid.Form > ComboBox">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="5" />
	</Style>

	<Style Selector="DataGridCell.small">
		<Setter Property="FontSize" Value="12" />
	</Style>

	<Style Selector="DataGridCell.right">
		<Setter Property="HorizontalContentAlignment" Value="Right" />
	</Style>

	<Style Selector="DataGridCell.center">
		<Setter Property="HorizontalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="DataGridRow TextBlock">
		<Setter Property="Margin" Value="10,0" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="DataGridRow CheckBox">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalAlignment" Value="Center" />
	</Style>

	<Style Selector="Grid.Form TimePicker Button">
		<Setter Property="MinWidth" Value="110" />
	</Style>

	<Style Selector="DataValidationErrors">
		<Setter Property="Theme" Value="{StaticResource TooltipDataValidationErrors}" />
	</Style>

	<Style Selector="filterCombo|AutoComboUserControl, filterCombo|ComboUserControl, filterDate|DateRangeUserControl, filterNumeric|NumericRangeUserControl, filterText|TextUserControl, filterTime|TimeRangeUserControl">
		<Setter Property="Margin" Value="5" />
	</Style>

</Styles>
