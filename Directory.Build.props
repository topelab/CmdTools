<Project>
  <PropertyGroup>
    <!-- Configuraciones comunes para todos los proyectos -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Asegura que se usen referencias de paquete en proyectos SDK-style -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- Versiones de proyectos -->
    <ProjectExtensionVersion>1.2.13</ProjectExtensionVersion>
    <ToolsVersion>1.1.44</ToolsVersion>
    <AvaloniaProjectRelations>1.1.13</AvaloniaProjectRelations>
  </PropertyGroup>
</Project>