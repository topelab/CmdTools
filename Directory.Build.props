<Project>
  <PropertyGroup>
    <!-- Configuraciones comunes para todos los proyectos -->
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Asegura que se usen referencias de paquete en proyectos SDK-style -->
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>

    <!-- Versiones de proyectos -->
    <ProjectExtensionVersion>1.1.3</ProjectExtensionVersion>
    <ToolsVersion>1.1.26</ToolsVersion>
    <AvaloniaProjectRelations>1.0.0</AvaloniaProjectRelations>
    
  </PropertyGroup>
</Project>
